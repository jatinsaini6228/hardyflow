# ==============================================================================
# HardyFlow Local AI & Llama 3 Configuration
# ==============================================================================
# Add your API key below. Supports Groq (fastest Llama 3), OpenAI, Together AI,
# OpenRouter, or completely local offline endpoints (Ollama / llama.cpp).
# ==============================================================================

# 1. API Key (e.g. gsk_... for Groq, or sk-... for OpenAI/Together/OpenRouter)
LLAMA_API_KEY=your_api_key_here

# 2. API Endpoint URL (OpenAI-compatible /chat/completions)
# For Groq Cloud (Recommended, instant inference):
LLAMA_API_URL=https://api.groq.com/openai/v1/chat/completions

# For Local Ollama on macOS (100% offline, free):
# LLAMA_API_URL=http://localhost:11434/v1/chat/completions

# For local llama-server / llama.cpp in this folder:
# LLAMA_API_URL=http://localhost:8080/v1/chat/completions

# 3. Model Name
# Groq options: llama-3.3-70b-versatile, llama-3.1-8b-instant
# Ollama options: llama3, llama3.2, llama3:8b
LLAMA_MODEL=llama-3.3-70b-versatile

# 4. Temperature (0.0 to 1.0, 0.3 recommended for precise formatting)
LLAMA_TEMPERATURE=0.3
